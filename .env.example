# OpenAI-compatible image API root. Keep /v1 in the URL.
IMAGE_API_BASE_URL=http://image-generation-api.llm-gateway.svc.cluster.local:8080/v1
IMAGE_API_KEY=replace-with-llm-gateway-api-key
IMAGE_MODEL=gpt-image-1

# Required gate for the app's same-origin generation endpoints.
# Generate a random value with: openssl rand -hex 32
APP_ACCESS_TOKEN=replace-with-a-long-random-token
